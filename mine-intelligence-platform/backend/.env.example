# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file - it is gitignored.

# Required for AI-phrased chatbot answers. Without it, the assistant still
# works but falls back to deterministic, non-LLM answers (see app/services/rag.py).
# Paste ONLY the raw key - no surrounding quotes, no trailing spaces/newline.
GROQ_API_KEY=your_actual_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
ASSISTANT_HISTORY_LIMIT=12

CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=15

# Set a stable random string in production so login tokens survive restarts.
JWT_SECRET_KEY=

DATA_DIR=./data
UPLOAD_DIR=./data/uploads
REPORTS_DIR=./data/reports
MODELS_DIR=./models
